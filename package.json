{
  "name": "pharmacy-pos",
  "version": "1.0.0",
  "description": "Pharmacy POS & Inventory Management System",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "@point-of-sale/receipt-printer-encoder": "latest",
    "better-sqlite3": "^11.8.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pharmacy.pos",
    "productName": "MediCare POS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MediCare POS"
    },
    "files": [
      "src/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ]
  }
}